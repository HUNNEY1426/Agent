PORT=3000
NODE_ENV=development
JWT_SECRET=agent_local_development_jwt_secret_key_2026_xyz
FRONTEND_URL=http://localhost:5173

# Default AI Provider (gemini | openai | claude | ollama | openrouter)
AI_PROVIDER=gemini
# Fallback order when primary provider fails (comma-separated)
AI_FALLBACK_PROVIDERS=openai,claude,ollama
# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
