{
    "watch": [
        "server.js",
        ".env",
        "routes",
        "services",
        "controllers",
        "config",
        "middleware",
        "database"
    ],
    "ext": "js,json",
    "ignore": [
        "memory/**",
        "memory/sessions/**",
        "memory/archives/**",
        "memory/exports/**",
        "database/*.db*",
        "uploads/**",
        "tests/**"
    ],
    "delay": "300"
}